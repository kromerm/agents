# ─────────────────────────────────────────────────────────────────────────────
# Azure AI Foundry Project
# ─────────────────────────────────────────────────────────────────────────────
# Your Foundry project endpoint (already filled in for you)
FOUNDRY_PROJECT_ENDPOINT=https://markkromer-linkedin-resource.services.ai.azure.com/api/projects/markkromer-linkedin

# Model deployment name — check at https://ai.azure.com under your project's Deployments
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# API key (alternative to `az login`). Get this from ai.azure.com → your project → Settings → API keys
AZURE_AI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Developer App
# Create one at https://developer.linkedin.com/apps then add:
#   • "Sign In with LinkedIn using OpenID Connect" product
#   • "Share on LinkedIn" product
# Set Redirect URL to: http://localhost:8888/callback
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Token  (set automatically by setup_linkedin_auth.py — do not edit)
# ─────────────────────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
